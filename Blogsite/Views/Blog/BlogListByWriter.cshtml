@{
    Layout = "~/Views/Shared/WriterLayout.cshtml";
}

@using Blogsite.EntityLayer.Concrete
@model List<Blog>


<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Bloglarım</h4>
            @* <h4 class="card-title">@Model[0].Writer.WriterName</h4> *@

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th> Resim </th>
                        <th> Başlık </th>
                        <th> İçerik </th>
                        <th> Kategori </th>
                        <th> Tarih </th>
                        <th> Durum </th>
                        <th> Düzenle </th>
                        <th> Sil </th>
                        
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model)
                    {
                        
                        <tr >
                            
                            <td class="py-1">
                                <a href="/Blog/BlogReadAll/@item.BlogId"><img src="@item.BlogThumbnailImage" alt="image"></a>
                                
                            </td>
                            <td>@item.BlogTitle</td>
                            <td>
                                    @item.BlogContent.Substring(0, item.BlogContent.Substring(0, 50).LastIndexOf(" "))  ...
                            </td>
                            <td> @item.Category.CategoryName </td>
                            <td> @(((DateTime)item.BlogCreateDate).ToString("dd-MMM-yyyy")) </td>
                            <td> @item.BlogStatus </td>

                            <td> <a href="/Blog/EditBlog/@item.BlogId" class="btn btn-info btn-sm">Düzenle</a></td>
                            <td> <a href="/Blog/DeleteBlog/@item.BlogId" class="btn btn-danger btn-sm">Sil</a></td>
                            
                        </tr>
                        
                        
                    }

                    
                    
                </tbody>
            </table>
        </div>
    </div>
</div>

<a href="/Blog/AddBlog/" class="btn btn-info btn-fw">Yeni Blog Oluştur</a>