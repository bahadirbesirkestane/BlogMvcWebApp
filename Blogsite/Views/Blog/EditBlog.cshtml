@{
    Layout = "~/Views/Shared/WriterLayout.cshtml";
}

@using Blogsite.EntityLayer.Concrete
@model Blog

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Yeni Blog Ekleme</h4>


            @using (Html.BeginForm("EditBlog", "Blog", FormMethod.Post))
            {
                <div class="form-group">
                    <label for="exampleInputName1">Blog Id</label>

                    @Html.TextBoxFor(x => x.BlogId, new { @class = "form-control", @readonly = "readonly" })
                    @Html.HiddenFor(x => x.BlogId)
                    

                </div>
                <div class="form-group">
                    <label for="exampleInputName1">Başlık</label>

                    @Html.TextBoxFor(x => x.BlogTitle, new { @class = "form-control" })
                    @Html.ValidationMessageFor(x => x.BlogTitle, "", new { @class = "text-danger" })

                </div>
                <div class="form-group">
                    <label for="exampleTextarea1">İçerik</label>
                    @Html.TextAreaFor(x => x.BlogContent, 10, 3, new { @class = "form-control" })
                    @Html.ValidationMessageFor(x => x.BlogContent, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <label for="exampleInputName1">Thumbnail Image</label>
                    @Html.TextBoxFor(x => x.BlogThumbnailImage, new { @class = "form-control" })
                    @Html.ValidationMessageFor(x => x.BlogThumbnailImage, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <label for="exampleInputName1">Image</label>
                    @Html.TextBoxFor(x => x.BlogImage, new { @class = "form-control" })
                    @Html.ValidationMessageFor(x => x.BlogImage, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <label for="exampleInputName1">Kategori Id</label>
                    @Html.DropDownListFor(x => x.CategoryId, (List<SelectListItem>)ViewBag.CategoryValue, new { @class = "form-control" })
                </div>

                <button class="btn btn-gradient-primary mr-2">Güncelle</button>
            }

        </div>
    </div>
</div>