@using Blogsite.EntityLayer.Concrete
@model List<Blog>

<div class="comment-top">
	<h4>Yorum Ekle</h4>
	<div class="comment-bottom">
		<form asp-controller="Comment" asp-action="AddComment" asp-route-blogId="@Model[0].BlogId" method="post">
			<input class="form-control" type="text" name="CommentUserName" placeholder="İsim Soyisim" required="">
			<input class="form-control" type="text" name="CommentTitle" placeholder="Başlık" required="">

			<textarea class="form-control" name="CommentContent" placeholder="Yorum bırakın..." required=""></textarea>
			<button type="submit" class="btn btn-primary submit">Gönder</button>
		</form>
	</div>
</div>