@model IEnumerable<Blogsite.Models.UserComment>

<div class="comment-top">
	<h4>Yorumlar</h4>
	<div class="media">
		<img src="~/BlogTema/images/t1.jpg" alt="" class="img-fluid" />
		<div class="media-body">

			@foreach(var item in Model)
			{
				<h5 class="mt-0">@item.UserName</h5>
				<p>
					@item.Id
				</p>
			}

			
		</div>
	</div>
</div>