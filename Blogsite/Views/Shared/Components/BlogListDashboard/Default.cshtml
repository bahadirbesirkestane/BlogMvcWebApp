@using Blogsite.EntityLayer.Concrete
@model List<Blog>



<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Bloglar</h4>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th> Resim </th>
                                <th> Başlık </th>
                                <th> İçerik </th>
                                <th> Kategori </th>
                                <th> Tarih </th>
                                <th> Detaylar </th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {

                                <tr>

                                    <td class="py-1">
                                        <a href="/Blog/BlogReadAll/@item.BlogId"><img src="@item.BlogThumbnailImage" alt="image"></a>

                                    </td>
                                    <td>@item.BlogTitle</td>
                                    <td>
                                        @item.BlogContent.Substring(0, item.BlogContent.Substring(0, 50).LastIndexOf(" "))  ...
                                    </td>
                                    <td> @item.Category.CategoryName </td>
                                    <td> @(((DateTime)item.BlogCreateDate).ToString("dd-MMM-yyyy")) </td>
                                    <td> <a href="/Blog/BlogReadAll/@item.BlogId" class="btn btn-danger btn-sm">Detay</a></td>

                                    
                                </tr>


                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>